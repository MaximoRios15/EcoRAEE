{
  "expo": {
    "name": "EcoRAEE",
    "slug": "ecoraee",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./img/logo-EcoRAEE.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./img/logo-EcoRAEE.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./img/logo-EcoRAEE.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
